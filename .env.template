# JasusiCLI v3.2 — API Keys
# ─────────────────────────────────────────────────────────────
# Two keys power all six models.
#
# 1. OpenRouter  → Developer, Executor, Architect, Reviewer
#    Get key : https://openrouter.ai/keys
#    Free tier: 50 RPD across all :free models
#    Unlock   : Add $10 credit once → 1,000 RPD (credit never consumed on :free models)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
#
# 2. Google AI Studio → Researcher, Compaction Agent
#    Get key  : https://aistudio.google.com/app/apikey
#    Limits   : Gemini 2.5 Pro: 100 RPD | Flash-Lite: 1,000 RPD
GOOGLE_AI_STUDIO_KEY=AIza-your-key-here

# Web UI access password (leave empty to disable auth for local use)
UI_PASSWORD=

# Phase 8 service profile (local is the safe default).
JASUSI_DEPLOYMENT_PROFILE=local
JASUSI_MAX_CONCURRENT_JOBS=4
JASUSI_MAX_QUEUE_SIZE=16
JASUSI_MAX_PROMPT_BYTES=65536
JASUSI_MAX_EVENT_BYTES=262144
JASUSI_GRACEFUL_DRAIN_TIMEOUT_SECONDS=30
# Required before any non-loopback service listener is enabled.
JASUSI_AUTH_BEARER_TOKEN=
